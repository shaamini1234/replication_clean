# ── Large database binaries (exceed GitHub's 100 MB file limit) ──
database/*.duckdb
database/*.duckdb.zst
database/*.duckdb.wal
database/*.wal

# NOTE: source_inputs/ and reports/ are intentionally COMMITTED (kept in the repo).
# Only the multi-GB database binaries above are excluded (GitHub's 100 MB limit).

# ── ONS geography cache (build input for the maps; regenerate with
#    python/fetch_ons_geography.py — ~235 MB zip + boundaries) ──
source_inputs/ons/

# ── EDGAR submissions cache (rebuildable: python/sp500_edgar_sector_fetch.py
#    refetches it. The RESULT — sp500_edgar_sector_enrichment.csv — IS committed) ──
source_inputs/.edgar_cache/

# ── Secrets: the Neon credential lives here, never in git ──
.env

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
bd-venv/
.ipynb_checkpoints/

